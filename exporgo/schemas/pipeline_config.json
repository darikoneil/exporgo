{
    "$defs": {
        "AnalysisConfig": {
            "additionalProperties": false,
            "properties": {
                "key": {
                    "default": null,
                    "title": "Unique key for the analysis type in the registry",
                    "type": "string"
                },
                "call": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "format": "path",
                            "type": "string"
                        }
                    ],
                    "default": null,
                    "title": "Analyzer for the experiment"
                },
                "file_sets": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        }
                    ],
                    "default": null,
                    "title": "Collection of file sets for organizing experiment"
                },
                "category": {
                    "$ref": "#/$defs/Category",
                    "default": 1,
                    "title": "Category of the analysis"
                },
                "status": {
                    "$ref": "#/$defs/Status",
                    "default": 0,
                    "title": "Status of the analysis"
                }
            },
            "title": "AnalysisConfig",
            "type": "object"
        },
        "Category": {
            "enum": [
                0,
                1,
                2
            ],
            "title": "Category",
            "type": "integer"
        },
        "Status": {
            "enum": [
                -2,
                -1,
                0,
                1,
                2,
                3
            ],
            "title": "Status",
            "type": "integer"
        }
    },
    "additionalProperties": false,
    "properties": {
        "steps": {
            "anyOf": [
                {
                    "$ref": "#/$defs/AnalysisConfig"
                },
                {
                    "items": {
                        "$ref": "#/$defs/AnalysisConfig"
                    },
                    "type": "array"
                }
            ],
            "default": null,
            "title": "Sequence of analysis steps"
        },
        "status": {
            "$ref": "#/$defs/Status",
            "default": 0,
            "title": "Pipeline Status"
        }
    },
    "title": "PipelineConfig",
    "type": "object"
}